# ==============================================
# MeetX Server Environment Variables
# ==============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────
# LiveKit Cloud
# Sign up at: https://cloud.livekit.io
# Create a project → get API Key + Secret
# ──────────────────────────────────────────────
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WS_URL=wss://your-project.livekit.cloud

# ──────────────────────────────────────────────
# Firebase Admin SDK
# Go to Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download JSON
# Fill in values from that JSON file below:
# ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────
# Database (PostgreSQL via Supabase)
# Sign up at: https://supabase.com
# Create project → Settings → Database → Connection String
# Use the "URI" format (Pooler recommended for serverless)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# ──────────────────────────────────────────────
# LiveKit Webhook Secret
# In LiveKit Cloud dashboard → Webhooks → create endpoint
# Set URL to: https://your-backend.railway.app/api/webhook/livekit
# Copy the signing secret here:
# ──────────────────────────────────────────────
LIVEKIT_WEBHOOK_SECRET=your_webhook_secret
